{
  "name": "afergon-ai",
  "version": "0.2.0",
  "description": "afergon-ai: a development harness with a disciplined debate-to-implementation pipeline, Gherkin-first specs, TDD enforcement, and Stitch design integration.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "bin": {
    "afergon-ai": "./bin/afergon-ai",
    "afergon-ai.cmd": "./bin/afergon-ai.cmd"
  },
  "keywords": [
    "afergon-ai",
    "sdd",
    "openspec",
    "gherkin",
    "tdd",
    "debate",
    "agent-harness"
  ],
  "scripts": {
    "build": "tsx ./scripts/build-typescript.ts",
    "health:runtime": "node ./dist/scripts/check-dist-runtime.js",
    "doctor:runtime": "node ./dist/scripts/check-dist-runtime.js --report",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.runtime.json --noEmit",
    "test": "pnpm build && vitest run --no-file-parallelism",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "adapters/",
    "bin/",
    "dist/",
    "scripts/",
    "skills/"
  ]
}
