{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "extensions/**/*.ts",
    "scripts/lib/model-profiles-core.ts",
    "scripts/lib/branding/**/*.ts",
    "scripts/lib/tui/command-manifest.ts",
    "scripts/lib/tui/navigation.ts",
    "scripts/lib/tui/config-status-adapter.ts",
    "scripts/lib/tui/model-profiles-adapter.ts",
    "scripts/lib/tui/actions/definitions.ts",
    "scripts/lib/tui/actions/forms-confirmation.ts",
    "scripts/lib/tui/actions/forms-output.ts",
    "scripts/lib/tui/actions/forms-state.ts",
    "scripts/lib/tui/actions/runner.ts",
    "scripts/lib/tui/screens/configuration.ts",
    "scripts/lib/tui/screens/model-profiles.ts",
    "scripts/lib/tui/screens/status.ts"
  ]
}
