#!/usr/bin/env bash
# afergon-ai CLI
#
# Usage:
#   afergon-ai tui
#   afergon-ai init [--pi] [--claude] [--opencode] [--all]
#   afergon-ai doctor [--opencode]
#   afergon-ai update
#   afergon-ai models [show [profile]|list|switch|set|profile]

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PACKAGE_ROOT="$(dirname "$SCRIPT_DIR")"
RUNTIME_ENTRYPOINT="$PACKAGE_ROOT/dist/scripts/cli-dispatch.js"

if [ ! -f "$RUNTIME_ENTRYPOINT" ]; then
  cat >&2 <<EOF
afergon-ai has not been built yet.

From the afergon-ai package root, run:
  pnpm build

Then run this command again.
EOF
  exit 1
fi

exec node "$RUNTIME_ENTRYPOINT" "$@"
